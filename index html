  function npRenderSingle() {
    const listEl = document.getElementById("np-items-list");
    const categories = [...new Set(NP_MENU.map(i => i.cat))];

    const totalProteinQty = NP_MENU.filter(i => i.role === "protein").reduce((s, i) => s + i.qty, 0);
    const earnedCredits = Math.floor(totalProteinQty);
    let remSideCredits = earnedCredits;
    let remSauceCredits = earnedCredits;

    const itemBilling = {};
    NP_MENU.forEach(item => {
      if (item.qty <= 0) {
        itemBilling[item.id] = { freeQty: 0, paidQty: 0, netCost: 0 };
        return;
      }
      if (item.role === "side" && remSideCredits > 0) {
        const covered = Math.min(item.qty, remSideCredits);
        remSideCredits -= covered;
        const paid = item.qty - covered;
        itemBilling[item.id] = { freeQty: covered, paidQty: paid, netCost: paid * item.price };
      } else if (item.role === "sauce" && remSauceCredits > 0) {
        const covered = Math.min(item.qty, remSauceCredits);
        remSauceCredits -= covered;
        const paid = item.qty - covered;
        itemBilling[item.id] = { freeQty: covered, paidQty: paid, netCost: paid * item.price };
