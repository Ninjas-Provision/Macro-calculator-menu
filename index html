    }
    const ua = navigator.userAgent || "";
    const isIOS = /iPad|iPhone|iPod/.test(ua);
    const sep = isIOS ? "&" : "?";
    window.location.href = `sms:${CHEF_PHONE}${sep}body=${encodeURIComponent(txt)}`;
  };

  npRenderSingle();
  npUpdateParty();
  npUpdateEvent();
})();
</script>

