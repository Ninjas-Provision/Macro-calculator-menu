  window.npSetQty = function(id, val) {
    const item = NP_MENU.find(i => i.id === id);
    if (!item) return;
    let raw = parseFloat(val) || 0;
    raw = (item.step === 1) ? Math.round(raw) : Math.round(raw * 2) / 2;
    item.qty = Math.max(0, Math.min(item.max, raw));
    npRenderSingle();
  };

  window.npResetAll = function() {
